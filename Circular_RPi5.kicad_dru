(version 1)

# Custom DRC rules for Circular_RPi5 CM5 carrier board.
#
# NOTE: a netclass "track_width" is only the DEFAULT width the router starts
# with -- it is NOT checked by DRC. The rules below are what actually enforce
# minimum copper on the high-current rails, so a thin track cannot silently
# come back.

# --- 5 V / 5 A input and distribution -------------------------------------
# /VBUS_IN carries the full board input current from J4 through F1; +5V is the
# post-fuse rail feeding the CM5 (up to ~5 A). On 1 oz outer copper (0.043 mm per
# this board's stackup) IPC-2221 gives 4.59 A at a 10 C rise for 2.0 mm and 5.86 A
# for 2.8 mm, so 2.0 mm is the floor and 2.8 mm the target.
#
# The 5 A path is F1 -> the In3.Cu +5V plane (4614 mm2) -> the CM5. Because it is
# plane-based, most +5V surface copper is a short local branch to a decoupling
# cap, an ESD diode bias pin, a TVS or an LED -- microamps to milliamps. A width
# rule across the whole net cannot tell those apart from the trunk (DRC has no
# topology), and a blanket 2.5 mm flagged 36 milliamp stubs as if they carried 5 A.
#
# So the constraint is scoped to the named rule areas "HC_5V", which cover the two
# stretches of surface copper that genuinely carry the full current: F1's output to
# its plane via, and the plane via that feeds the CM5 +5V pins. Widen those areas
# if the high-current topology changes.
(rule "5A power minimum track width"
	(condition "A.NetClass == 'Power_5A' && A.Type == 'track' && A.insideArea('HC_5V')")
	(constraint track_width (min 2.0mm) (opt 2.8mm)))

(rule "5A power minimum via size"
	(condition "A.NetClass == 'Power_5A' && A.Type == 'via'")
	(constraint via_diameter (min 0.7mm))
	(constraint hole_size (min 0.35mm)))

# --- High-speed differential pairs ----------------------------------------
# Geometry targets ~90 ohm (USB3) and ~100 ohm (Ethernet/HDMI/MIPI) as
# edge-coupled microstrip referenced to the In1/In4 GND planes across 0.23 mm
# prepreg, er 4.4. First-order estimates -- confirm against the fabricator's
# impedance model before release.
#
# Scoped to (layer outer) deliberately: these widths are ONLY valid on F.Cu and
# B.Cu. In2.Cu sits between In1 (GND, 0.38 mm) and In3 (+5V, 0.15 mm), which is
# an asymmetric stripline needing a different width for the same impedance, so
# applying the microstrip number there would be wrong. Pairs routed on In2.Cu
# still need their own impedance check -- this rule simply does not speak to it.
(rule "USB3 SuperSpeed pair width"
	(layer outer)
	(condition "A.NetClass == 'HS_90_USB3' && A.Type == 'track'")
	(constraint track_width (min 0.19mm) (opt 0.22mm) (max 0.26mm)))

(rule "100 ohm pair width"
	(layer outer)
	(condition "A.NetClass == 'HS_100' && A.Type == 'track'")
	(constraint track_width (min 0.17mm) (opt 0.20mm) (max 0.24mm)))
